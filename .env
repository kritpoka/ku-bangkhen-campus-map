# Absolute site URL used in link-preview meta tags (index.html). This is only a
# placeholder: set VITE_SITE_URL in the build environment (Vercel → Settings →
# Environment Variables), e.g. https://ku-map.vercel.app or https://<user>.github.io/ku-map.
# A real environment variable overrides this file. Production builds on Vercel/CI
# fail while it is still the placeholder.
VITE_SITE_URL=https://ku-map-beta.vercel.app
